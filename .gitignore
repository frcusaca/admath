#
# What git ignores. Everything here can be re-created (`make setup`, `make site`, …).
# `make check-gitignore` tests these rules against real junk and real source.
# Patterns without a leading "/" apply in every folder; "/x/" means only at the top.

# ---- this project's tools and build output ----------------------------------
/.venv/
# Quarto and TinyTeX (make setup-quarto)
/.tools/
# staged site with executed notebooks (make stage)
/.build/
# Claude Code session notes
/.remember/
node_modules/
/_site/
/_site-teacher/
/.quarto/
# Colab bundle (make colab)
/dist/
/explorer/dist/
/explorer/test-results/
/explorer/playwright-report/
# Quarto's temporary copies of .qmd pages
*.quarto_ipynb
# LaTeX and logs left behind by a failed PDF render
/*.tex
/*.log
/notebooks/*.tex
/notebooks/*.log
/_freeze/

# ---- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
# packaging output, only where packaging happens (the root and python/), so that
# source folders called build/, lib/, … elsewhere are never hidden
/build/
/python/build/
/python/dist/
*.egg-info/
*.egg
.eggs/
# test and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/

# ---- Jupyter ------------------------------------------------------------------
.ipynb_checkpoints/
.ipython/
.jupyter/
.virtual_documents/

# ---- editors and operating systems ------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
